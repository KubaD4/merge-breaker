# Vultr Serverless Inference (all LLM calls go here; this key never enters a sandbox)
VULTR_INFERENCE_API_KEY=
MB_MODEL=glm-5.3
# Optional
# "runsc" to run sandboxes under gVisor
MB_RUNTIME=
# token that unlocks scanning arbitrary GitHub repos from the UI
MB_RUN_TOKEN=
# GitHub webhook secret (push to main / merged PR triggers a run)
MB_WEBHOOK_SECRET=
# comma-separated owner/repo allowlist for the webhook
MB_ALLOWED_REPOS=
# cap on model thinking tokens; fallback model if the main one returns nothing
MB_REASONING_TOKENS=2500
MB_FALLBACK_MODEL=qwen3.8-27b
